{
  "name": "tredeig-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node -e \"const fs=require('fs'),cp=require('child_process');if(fs.existsSync('backend')){process.chdir('backend');}cp.execSync('npm install --include=dev && npm run build',{stdio:'inherit'});\"",
    "start": "node -e \"const fs=require('fs'),cp=require('child_process');if(fs.existsSync('backend')){process.chdir('backend');}cp.execSync('npm start',{stdio:'inherit'});\""
  }
}
